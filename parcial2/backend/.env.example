# GangaSaaS Parcial 2 - Variables de Entorno
# Copiar este archivo a .env para desarrollo local o configurar en el panel Environment de Render.

# --- Base de Datos ---
# Para desarrollo local usa SQLite:
DATABASE_URL=sqlite:///./ganga_saas.db
# Para producción en Render (persistencia real con Neon / Supabase):
# DATABASE_URL=postgresql://usuario:password@ep-xxxxx.neon.tech/gangasaas?sslmode=require

# --- Seguridad ---
JWT_SECRET=cambia-esto-en-produccion-por-un-secret-largo-y-aleatorio
JWT_ALG=HS256
JWT_EXP_MINUTES=480

# --- CORS ---
CORS_ORIGINS=*

# --- Inteligencia Artificial (CU-28 Asistente y Reportes por voz) ---
# Clave gratuita de Google AI Studio (https://aistudio.google.com/apikey)
# Se acepta como GEMINI_API, GEMINI_API_KEY o GOOGLE_API_KEY.
GEMINI_API=
GEMINI_MODELO=gemini-3.5-flash-lite,gemini-3.8-flash

# --- Pagos de prueba ---
# Solo se aceptan claves sk_test_; nunca se procesa dinero real.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# El simulador genera QR locales. Para sandbox/live se requiere un certificado
# de cliente BCP válido y las credenciales correspondientes en el entorno.
BCP_MODO=simulado
BCP_USUARIO=
BCP_PASSWORD=
BCP_APP_USER_ID=
BCP_PUBLIC_TOKEN=
BCP_BUSINESS_CODE=
BCP_SERVICE_CODE=050
BCP_CERT_PEM=
BCP_CERT_KEY=
BCP_CERT_PFX=
BCP_CERT_PASSWORD=
BCP_QR_MINUTOS=15

